# Copy to .env.local, or run `npm run env:local` while `npx supabase start` is running.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=paste-the-publishable-key-from-supabase-status
# Show the "Sign in with GitHub" button (see [auth.external.github] in supabase/config.toml).
NEXT_PUBLIC_GITHUB_LOGIN=false
